rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connectivity test probe
    match /test/{testId} {
      allow read: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && incoming().id == userId
        && incoming().displayName is string
        && incoming().displayName.size() >= 2
        && incoming().displayName.size() <= 80;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && incoming().id == userId;
      allow delete: if false;
    }

    // Friend Requests
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isSignedIn()
        && incoming().senderId == request.auth.uid
        && incoming().receiverId != request.auth.uid
        && incoming().status == 'pending'
        && isValidId(incoming().receiverId);
      allow update: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.users);
      allow create: if isSignedIn() && (request.auth.uid in incoming().users);
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.users);
    }

    // Private Chats
    match /privateChats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in incoming().participants);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participants);

      // Private Messages Subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participants
        );
        allow create: if isSignedIn() 
          && (request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participants)
          && incoming().senderId == request.auth.uid
          && incoming().text is string
          && incoming().text.size() > 0
          && incoming().text.size() <= 2000;
        allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Main Space Chats (Microbiology, Biological Sciences, Biochemistry, Molecular Biology, Announcements, Market)
    match /spaces/{spaceId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().senderId == request.auth.uid
        && incoming().text is string
        && incoming().text.size() > 0
        && incoming().text.size() <= 3000;
      allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // Market Items
    match /marketItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().sellerId == request.auth.uid
        && incoming().title is string
        && incoming().title.size() >= 3
        && incoming().title.size() <= 120
        && incoming().description is string
        && incoming().description.size() <= 1500;
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().authorId == request.auth.uid
        && incoming().title is string
        && incoming().title.size() >= 3
        && incoming().title.size() <= 150;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Sports Updates & Fixtures
    match /sportsUpdates/{updateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().title is string
        && incoming().title.size() >= 3
        && incoming().title.size() <= 150;
      allow update, delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        incoming().authorId == request.auth.uid
      );
    }

    // Football Announcements (Posted by Admins / Course Reps)
    match /footballAnnouncements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().title is string
        && incoming().title.size() >= 3
        && incoming().title.size() <= 150;
      allow update, delete: if isSignedIn();
    }

    // Football Comments & Threaded Conversation
    match /footballComments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().text is string
        && incoming().text.size() > 0
        && incoming().text.size() <= 2000;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        incoming().authorId == request.auth.uid
      );
    }

    // Match Live Chats
    match /matchLiveChats/{matchId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().senderId == request.auth.uid
        && incoming().text is string
        && incoming().text.size() > 0
        && incoming().text.size() <= 2000;
      allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }
  }
}
